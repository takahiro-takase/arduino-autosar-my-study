// CAPL 風 DSL の for文・this.byte(n)/this.id/this.dlc・printf風フォーマットのサンプル (.capl)。
//
// example_session_check.capl (最小構成) → example_variables_control_flow.capl
// (variables{}/if/while) に続く第3段。文法の詳細は README.md の
// 「CAPL 風スクリプト機能」を参照。

variables
{
    message 0x100 engineInfoMsg;
    byte e2eCnt_0x100;
    byte e2eCnt_0x220;
    byte e2eCrcErrCount;
    byte e2eSeqErrCount;

    int  msgIndex;
    byte msgData[32];

    // E2EProfile01 CRC 検証 (ReceiveE2EHealthStatus()) 用の前回カウンタ値。
    // このDSLの関数ローカル変数は (実CAPLの「static相当・呼び出しをまたいで
    // 値を保持する」ローカル変数とは違い) 呼び出しのたびに再初期化され、
    // 呼び出しが終わると値も消える。次に届いたフレームのカウンタと比較する
    // ために前回値を残しておく必要があるので、e2eCnt だけはグローバルに置く
    // (e2eIndex/e2eData/e2eDataLen/e2eCrc は毎回作り直せばよいので
    // ReceiveE2EHealthStatus() のローカル変数のままでよい)。
}

on start
{
    e2eCnt_0x100   = 0x00;
    e2eCnt_0x220   = 0x00;
    e2eCrcErrCount = 0xFF;
    e2eSeqErrCount = 0xFF;

    write("停止するには「停止」ボタンを押してください。");
    setTimer(TimeoutA, 6000);
}

on timer TimeoutA
{
    SendMessage_EngineInfo(0, 0 ,1, 1);
    setTimer(TimeoutB, 6000);  // CAPL の msTimer と同じく単発なので、繰り返すには再度アームする
}

on timer TimeoutB
{
    SendMessage_EngineInfo(0, 0 ,1, 2);
//    setTimer(TimeoutC, 6000);  // CAPL の msTimer と同じく単発なので、繰り返すには再度アームする
}

// -----------------------------------------------------------------------------
// EngineInfo
// -----------------------------------------------------------------------------
void SendMessage_EngineInfo(word speed, byte coolant, byte onFlag, byte errorFlag)
{
    byte data[5];

    if (errorFlag == 2)
    {
        // CNT異常
        e2eCnt_0x100 = (e2eCnt_0x100 + 3) % 15;
    }

    data[0] = e2eCnt_0x100;
    data[1] = (speed >> 8) & 0xFF;
    data[2] = speed & 0xFF;
    data[3] = coolant;
    data[4] = (onFlag & 0x01) << 7;

    engineInfoMsg.dlc = 6;
    engineInfoMsg.byte(0) = CalcE2EProfile01CRC(0x0100, 5, data);
    engineInfoMsg.byte(1) = data[0];
    engineInfoMsg.byte(2) = data[1];
    engineInfoMsg.byte(3) = data[2];
    engineInfoMsg.byte(4) = data[3];
    engineInfoMsg.byte(5) = data[4];

    if (errorFlag == 1)
    {
        // CRC異常
        engineInfoMsg.byte(0) = 0;
    }

    output(engineInfoMsg);

    e2eCnt_0x100 = (e2eCnt_0x100 + 1) % 15;
}

// -----------------------------------------------------------------------------
// E2EHealthStatus
// -----------------------------------------------------------------------------
on message 0x220
{
    for (msgIndex = 0; msgIndex < this.dlc; msgIndex++)
    {
        msgData[msgIndex] = this.byte(msgIndex);
    }
    ReceiveMessage_E2EHealthStatus(this.id, this.dlc, msgData);
}

void ReceiveMessage_E2EHealthStatus(word id, byte dlc, byte data[])
{
    // e2eIndex/e2eData/e2eDataLen/e2eCrc は呼び出しのたびに作り直す作業変数
    // なのでローカルのままでよい。e2eCnt (前回受信カウンタ) だけは呼び出しを
    // またいで値を保持する必要があるため variables{} のグローバルに置いてある
    // (このDSLの関数ローカル変数は呼び出しのたびに再初期化される。実CAPLの
    // 「static相当」ローカル変数とは異なる点、詳細は variables{} 側のコメント参照)。
    byte e2eIndex;
    byte e2eData[32];
    byte e2eDataLen;
    byte e2eCrc;
    byte received;
    byte delta;
//  byte e2eCnt;
//  byte e2eCrcErrCount;
//  byte e2eSeqErrCount;
    // この CAN フレームは E2E (先頭4バイト: CRC/Counter/CrcErrCount/SeqErrCount)
    // をさらに SecOC (byte[4]=Freshness、byte[5-7]=MAC) で保護した Secured I-PDU
    // (src/Bsw/SecOC/SecOC_PBCfg.c の E2EHealthStatus 設定参照) なので dlc は 8 だが、
    // E2E の CRC 計算対象は Com/E2E 自身が知る 4 バイト (SecOC の Freshness/MAC は
    // 含まない) に限定する。
    e2eDataLen = 0;
    for (e2eIndex = 1; e2eIndex < 4; e2eIndex++)
    {
        e2eData[e2eDataLen] = data[e2eIndex];
        e2eDataLen++;
    }
    e2eCrc = CalcE2EProfile01CRC(0x0220, e2eDataLen, e2eData);
    if (data[0] == e2eCrc)
    {
        // E2E Profile1 の Counter は byte[1] の下位4bitのみが有効(0〜14の15値循環、
        // 15は予約値でスキップ)。E2E_P01.c の E2E_P01Check() と同じ mod-15
        // ラップアラウンド計算 (14 の次に 0 が来ても正常、という判定をするために必要)。
        received = data[1] & 0x0F;
        if (received >= e2eCnt_0x220)
        {
            delta = received - e2eCnt_0x220;
        }
        else
        {
            delta = (15 + received) - e2eCnt_0x220;
        }

        if (delta == 1)
        {
            if ( (data[2] == e2eCrcErrCount) &&
                 (data[3] == e2eSeqErrCount) )
            {
                // 変化なし
                //write("RX id=0x%x dlc=%d CRC:OK CNT:OK(0x%02x) CrcErrCNT:0x%02x SeqErrCNT:0x%02x)", id, dlc, data[1], data[2], data[3]);
            }
            else
            {
                write("RX id=0x%x dlc=%d CRC:OK CNT:OK(0x%02x) CrcErrCNT:0x%02x SeqErrCNT:0x%02x)", id, dlc, data[1], data[2], data[3]);
            }
        }
        else
        {
            write("RX id=0x%x dlc=%d CRC:OK CNT:NG(0x%02x) CrcErrCNT:0x%02x SeqErrCNT:0x%02x)", id, dlc, data[1], data[2], data[3]);
        }

        // Counter/エラーカウンタの状態は CRC が正しかった時だけ更新する
        // (E2E_P01Check() と同じ「CRC 不一致時は状態を一切変更しない」挙動。
        // 次に CRC が正しいフレームが来た時点で、その前の正常な状態を基準に
        // 通常通り判定できるようにするため)。
        e2eCnt_0x220   = received;
        e2eCrcErrCount = data[2];
        e2eSeqErrCount = data[3];
    }
    else
    {
        write("RX id=0x%x dlc=%d CRC:NG CNT:--(0x%02x))", id, dlc, data[1]);
    }
}

// -----------------------------------------------------------------------------
// E2EProfile01
// -----------------------------------------------------------------------------

// CRC8 (poly=0x1D) へ1バイト分を投入する。DataID・データ本体どちらの投入も
// 中身は同じなので、CalcE2EProfile01CRC() から2箇所で共用する (小さなヘルパー
// 関数に切り出すことで、8bit シフトループを2重に持たずに済む)。
byte UpdateCrc8(byte crc, byte b)
{
    byte poly = 0x1D;
    int i;

    crc ^= b;
    for (i = 0; i < 8; i++)
    {
        if (crc & 0x80)
        {
            crc = (crc << 1) ^ poly;
        }
        else
        {
            crc <<= 1;
        }
    }
    return crc;
}

byte CalcE2EProfile01CRC(word dataId, byte len, byte data[])
{
    // 開始値は 0x00 (SWS_E2E_00083、src/Bsw/E2E/E2E_P01.c の E2E_CalcCrc8() と同じ)。
    // 0xFF ではない (実CRC-8-SAE-J1850の一般的な初期値とは異なる、本プロジェクト
    // 固有の採用バリアント)。
    byte crc = 0x00;
    byte index;

    // DataID (word、実機の E2E_P01ConfigType.DataID と同じ16bit1個の値) を
    // 下位バイト→上位バイトの順に CRC へ投入する (src/Bsw/E2E/E2E_P01.c の
    // E2E_P01Check()/E2E_P01Protect() と同じ順序・同じ分解)。
    crc = UpdateCrc8(crc, dataId & 0xFF);
    crc = UpdateCrc8(crc, (dataId >> 8) & 0xFF);

    // データ本体を CRC に投入
    for (index = 0; index < len; index++)
    {
        crc = UpdateCrc8(crc, data[index]);
    }

    return crc;
}

