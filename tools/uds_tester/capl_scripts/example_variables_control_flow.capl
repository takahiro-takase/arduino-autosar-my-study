// CAPL 風 DSL の変数・制御構文サンプル (.capl)。
//
// example_session_check.capl (最小構成: on start/on timer/on message と関数呼び出し文
// のみ) に続く第2段。variables{} での int/float 宣言、if/else if/else、while、
// 四則演算・比較・論理演算子を使った例。文法の詳細は README.md の
// 「CAPL 風スクリプト機能」を参照。

variables
{
    int i;              // while ループのカウンタ
    int engineStatusCount;  // on message で受信するたびに増やすカウンタ
}

on start
{
    write("=== 変数・制御構文のサンプル ===");

    // on message はインタプリタ構築直後からずっと有効で、wait() 呼び出し中も止まらない。
    // そのため EngineStatus(0x200) はこの下の while ループの中 (TesterPresent 送信間の
    // wait(1.0)) で届いても数えられる。「ここから数え始める」という区切りは無いので、
    // 途中で engineStatusCount を 0 に戻すような書き方はしない (既にカウント済みの
    // 受信を握りつぶしてしまうため)。
    write("EngineStatus (0x200) の受信回数を数えます (このスクリプトの実行中ずっと)。");

    send(0x10, 0x03);      // ExtendedSession へ遷移
    wait_response();
    assert_positive();
    write("ExtendedSession OK");

    // while ループで TesterPresent を3回送る (setTimer/on timer を使わない書き方の例)
    i = 0;
    while (i < 3)
    {
        send(0x3E, 0x00);
        wait_response(1.0);
        write("TesterPresent ", i + 1, "/3 送信");
        i = i + 1;
        wait(1.0);
    }

    write("停止するには「停止」ボタンを押してください。");
}

on message 0x200
{
    engineStatusCount = engineStatusCount + 1;

    // if / else if / else と比較演算子の例
    if (msgData(0) == 0)
    {
        write("EngineStatus #", engineStatusCount, ": OFF");
    }
    else if (msgData(0) == 2)
    {
        write("EngineStatus #", engineStatusCount, ": RUNNING");
    }
    else
    {
        write("EngineStatus #", engineStatusCount, ": state=", msgData(0));
    }
}
