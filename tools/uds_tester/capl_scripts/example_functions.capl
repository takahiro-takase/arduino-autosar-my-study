// CAPL 風 DSL のユーザー定義関数・関数内ローカル変数のサンプル (.capl)。
//
// example_session_check.capl (最小構成) → example_variables_control_flow.capl
// (variables{}/if/while) → example_for_this_printf.capl (for/this構文/printf) →
// example_switch_array.capl (switch/配列) に続く第5段。文法の詳細は README.md の
// 「CAPL 風スクリプト機能」を参照。

// int 関数: TesterPresent を1回送って応答有無を 1/0 で返す。
int testerPresentOnce()
{
    send(0x3E, 0x00);
    wait_response(1.0);
    if (respSid() == 0x7E)
    {
        return 1;
    }
    return 0;
}

// int 関数 + ローカル変数: TesterPresent を3回送って成功回数を返す。
// successCount/i は variables{} に置かず、この関数の中だけで使うローカル変数として
// 宣言している (`variables { }` で包む必要はない)。呼び出しが終わるとこの2つの
// 名前は忘れられ、他の関数やグローバルの同名変数と干渉しない。
int testerPresentRetries()
{
    int successCount;
    int i;
    for (i = 0; i < 3; i++)
    {
        if (testerPresentOnce())
        {
            successCount++;
        }
        wait(0.5);
    }
    return successCount;
}

// void 関数: DID 読み出し+結果ログ出力という一連の処理をまとめる。
// 仮引数 (didHigh, didLow) はこの関数の中でだけ使えるローカルな名前。
void readDid(int didHigh, int didLow)
{
    send(0x22, didHigh, didLow);
    wait_response();
    if (respSid() == 0x62)
    {
        write("DID 0x%x%x OK", didHigh, didLow);
    }
    else
    {
        write("DID 0x%x%x NG (SID=0x%x NRC=0x%x)", didHigh, didLow, respSid(), respNrc());
    }
}

on start
{
    write("=== ユーザー定義関数・ローカル変数のサンプル ===");

    send(0x10, 0x03);      // ExtendedSession へ遷移
    wait_response();
    assert_positive();
    write("ExtendedSession OK");

    write("TesterPresent 成功 %d/3 回", testerPresentRetries());

    readDid(0xF1, 0x90);   // VIN
    readDid(0xF1, 0x87);   // 例: 別の DID (未実装なら NRC 分岐側のログが出る)
}
