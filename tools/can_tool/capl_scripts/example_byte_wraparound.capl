// CAPL 風 DSL の byte スカラー変数 (0〜255 ラップアラウンド) のサンプル (.capl)。
//
// example_session_check.capl (最小構成) → ... → example_message.capl
// (int/float 配列・message 変数・ビット演算子) に続く第7段。文法の詳細は
// README.md の「CAPL 風スクリプト機能」を参照。
//
// この DSL の int/float は Python の多倍長整数・浮動小数点数なのでオーバーフロー
// してもラップアラウンドしないが、byte はスカラー変数として宣言すると代入の
// たびに 0〜255 にラップアラウンドする (C/CAPL の固定幅整数型と同じ挙動、
// & 0xFF)。8bit 幅の信号・カウンタのラップアラウンドをテストしたい場合に使う。

// byte 配列の中身を単純合計してチェックサム (0〜255) を返す例。
// byte 仮引数・戻り値・ローカル変数はいずれも代入のたびにラップアラウンドする。
byte checksum8(byte a, byte b, byte c)
{
    byte sum;
    sum = a + b + c;   // 例: 200+100+50=350 は 8bit 幅では 94 になる
    return sum;
}

// 8bit カウンタ信号が 253 から 0 に巻き戻る様子をシミュレートする
// (DUT がこの手のラップアラウンドを正しく扱えるかをテストする時の典型パターン)。
// ローカル変数は関数の直接の本体でのみ宣言できるため、on start に直接は
// 書けず、この関数の中にまとめている。
void showSignalWraparound()
{
    byte signalValue;
    int i;
    signalValue = 253;
    for (i = 0; i < 5; i++)
    {
        write("signalValue=%d", signalValue);
        signalValue++;
    }
}

on start
{
    write("=== byte スカラー変数 (0-255 ラップアラウンド) のサンプル ===");

    write("checksum8(200,100,50)=%d", checksum8(200, 100, 50));  // 350 & 0xFF = 94
    write("checksum8(255,255,255)=%d", checksum8(255, 255, 255)); // 765 & 0xFF = 253

    showSignalWraparound();
}
