// 実機検証: Dcm の DID 表（Dcm.json から生成した Dcm_Cfg の DID 表）を経由した
// UDS 0x22 ReadDataByIdentifier / 0x2E WriteDataByIdentifier /
// 0x2F InputOutputControlByIdentifier の動作確認。
//
// 確認すること:
//   - 0x22 : 読み出し対応の DID（0x0101-0x0104, 0xF190）が正応答になる。
//            読み出し関数を持たない DID（0x0105 ランプ, 0x0108 鍵更新）や
//            表に無い DID は NRC 0x31。
//   - 0x2E : 書き込み対応の DID（0x0104 TestPattern）に書き込み→読み戻しで
//            同じ値が返る。セキュリティ未解除は NRC 0x33、長さ違いは NRC 0x13、
//            書き込み関数を持たない DID は NRC 0x31。
//   - 0x2F : ランプ DID（0x0105-0x0107）の controlOption 0x00-0x03 が正応答、
//            表に無い/ランプ以外の DID は NRC 0x31、長さ違いは NRC 0x13。
//            defaultSession では NRC 0x7F。
//
// 使い方: ECU に接続した状態で「スクリプト実行...」からこのファイルを選ぶ。
// 結果は各テストの PASS/FAIL と末尾の集計がログに出る。
// 途中でタイムアウトした場合はスクリプトが中断されるので、ECU の状態を確認すること。
// 0x2F のテストはランプを一時的に固定するため、最後に returnControlToECU で戻す。

variables
{
    int passCount;
    int failCount;
}

void reportOk(int ok)
{
    if (ok)
    {
        write("  -> PASS");
        passCount = passCount + 1;
    }
    else
    {
        write("  -> FAIL (SID=0x%02x NRC=0x%02x)", respSid(), respNrc());
        failCount = failCount + 1;
    }
}

// 直近の応答が、要求 SID の正応答（SID+0x40）かを判定する。
void expectPositive(int sid)
{
    reportOk(respSid() == sid + 0x40);
}

// 直近の応答が、指定 NRC の負応答かを判定する。
void expectNrc(int nrc)
{
    reportOk(respIsNegative() && (respNrc() == nrc));
}

on start
{
    write("=== Dcm DID 表の実機検証 (0x22 / 0x2E / 0x2F) ===");

    // ---- セッション・セキュリティの前提確認 ----
    write("T01 defaultSession で 0x2F ランプ制御 -> NRC 0x7F");
    send(0x10, 0x01);
    wait_response();
    send(0x2F, 0x01, 0x05, 0x03, 0x01);
    wait_response();
    expectNrc(0x7F);

    send(0x10, 0x03);
    wait_response();
    assert_positive();
    write("ExtendedSession に遷移");

    write("T02 セキュリティ未解除で 0x2E TestPattern 書き込み -> NRC 0x33");
    send(0x2E, 0x01, 0x04, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88);
    wait_response();
    expectNrc(0x33);

    security_unlock();
    write("SecurityAccess Level1 解除");

    // ---- 0x22 ReadDataByIdentifier ----
    write("T03 0x22 DID 0x0101 EngineSpeed (2byte)");
    send(0x22, 0x01, 0x01);
    wait_response();
    expectPositive(0x22);

    write("T04 0x22 DID 0x0102 CoolantTemp (1byte)");
    send(0x22, 0x01, 0x02);
    wait_response();
    expectPositive(0x22);

    write("T05 0x22 DID 0x0103 EngineState (1byte)");
    send(0x22, 0x01, 0x03);
    wait_response();
    expectPositive(0x22);

    write("T06 0x22 DID 0x0104 TestPattern (8byte, マルチフレーム応答)");
    send(0x22, 0x01, 0x04);
    wait_response();
    expectPositive(0x22);

    write("T07 0x22 DID 0xF190 VIN (17byte, マルチフレーム応答)");
    send(0x22, 0xF1, 0x90);
    wait_response();
    expectPositive(0x22);

    write("T08 0x22 DID 0x0105 (読み出し関数なし) -> NRC 0x31");
    send(0x22, 0x01, 0x05);
    wait_response();
    expectNrc(0x31);

    write("T09 0x22 DID 0x0108 (書き込み専用) -> NRC 0x31");
    send(0x22, 0x01, 0x08);
    wait_response();
    expectNrc(0x31);

    write("T10 0x22 DID 0xFFFF (表に無い) -> NRC 0x31");
    send(0x22, 0xFF, 0xFF);
    wait_response();
    expectNrc(0x31);

    write("T11 0x22 DID 2個指定 (長さ違い) -> NRC 0x13");
    send(0x22, 0x01, 0x01, 0x01, 0x02);
    wait_response();
    expectNrc(0x13);

    // ---- 0x2E WriteDataByIdentifier ----
    write("T12 0x2E DID 0x0104 TestPattern 書き込み (FF+CF)");
    send(0x2E, 0x01, 0x04, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88);
    wait_response();
    expectPositive(0x2E);

    write("T13 0x22 DID 0x0104 読み戻し -> 書き込んだ値と一致");
    send(0x22, 0x01, 0x04);
    wait_response();
    reportOk((respSid() == 0x62) &&
             (respByte(3) == 0x11) && (respByte(4) == 0x22) &&
             (respByte(5) == 0x33) && (respByte(6) == 0x44) &&
             (respByte(7) == 0x55) && (respByte(8) == 0x66) &&
             (respByte(9) == 0x77) && (respByte(10) == 0x88));

    write("T14 0x2E DID 0x0104 データ長不足 -> NRC 0x13");
    send(0x2E, 0x01, 0x04, 0x11, 0x22, 0x33);
    wait_response();
    expectNrc(0x13);

    write("T15 0x2E DID 0x0101 (書き込み関数なし) -> NRC 0x31");
    send(0x2E, 0x01, 0x01, 0x00, 0x00);
    wait_response();
    expectNrc(0x31);

    write("T16 0x2E DID 0x0105 (ランプ DID は 0x2F 専用) -> NRC 0x31");
    send(0x2E, 0x01, 0x05, 0x01);
    wait_response();
    expectNrc(0x31);

    // ---- 0x2F InputOutputControlByIdentifier ----
    write("T17 0x2F DID 0x0105 shortTermAdjustment ON -> 6F 01 05 03 01");
    send(0x2F, 0x01, 0x05, 0x03, 0x01);
    wait_response();
    reportOk((respSid() == 0x6F) && (respByte(3) == 0x03) && (respByte(4) == 0x01));

    write("T18 0x2F DID 0x0105 shortTermAdjustment OFF -> 6F 01 05 03 00");
    send(0x2F, 0x01, 0x05, 0x03, 0x00);
    wait_response();
    reportOk((respSid() == 0x6F) && (respByte(3) == 0x03) && (respByte(4) == 0x00));

    write("T19 0x2F DID 0x0106 resetToDefault -> status 0");
    send(0x2F, 0x01, 0x06, 0x01);
    wait_response();
    reportOk((respSid() == 0x6F) && (respByte(3) == 0x01) && (respByte(4) == 0x00));

    write("T20 0x2F DID 0x0107 freezeCurrentState");
    send(0x2F, 0x01, 0x07, 0x02);
    wait_response();
    expectPositive(0x2F);

    write("T21 0x2F DID 0x0105 shortTermAdjustment 値範囲外 (2) -> NRC 0x31");
    send(0x2F, 0x01, 0x05, 0x03, 0x02);
    wait_response();
    expectNrc(0x31);

    write("T22 0x2F DID 0x0105 controlOption 未対応 (0x09) -> NRC 0x31");
    send(0x2F, 0x01, 0x05, 0x09);
    wait_response();
    expectNrc(0x31);

    write("T23 0x2F DID 0x0101 (ランプ以外) -> NRC 0x31");
    send(0x2F, 0x01, 0x01, 0x03, 0x01);
    wait_response();
    expectNrc(0x31);

    write("T24 0x2F DID 0x0105 shortTermAdjustment で状態値なし (長さ不足) -> NRC 0x13");
    send(0x2F, 0x01, 0x05, 0x03);
    wait_response();
    expectNrc(0x13);

    write("T25 0x2F 長さ不足 (DID のみ) -> NRC 0x13");
    send(0x2F, 0x01, 0x05);
    wait_response();
    expectNrc(0x13);

    // ---- 後始末: 固定したランプを ECU の制御へ戻す ----
    write("後始末: 0x0106, 0x0107 を returnControlToECU (0x0105 は T26 で戻す)");
    send(0x2F, 0x01, 0x06, 0x00);
    wait_response();
    send(0x2F, 0x01, 0x07, 0x00);
    wait_response();
    write("T26 0x2F DID 0x0105 returnControlToECU -> 6F 01 05 00");
    send(0x2F, 0x01, 0x05, 0x00);
    wait_response();
    reportOk((respSid() == 0x6F) && (respByte(3) == 0x00));

    write("=== 集計: PASS=%d FAIL=%d ===", passCount, failCount);
}
