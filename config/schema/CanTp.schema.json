{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanTp configuration",
  "description": "CanTp_Cfg.h のフロー制御・タイムアウト・ID の定義の生成元。診断応答を送る CanIf の TX PDU は、CanIf.json の txPdus の名前で指す（生成物ではシンボリック名 CanIfConf_CanIfTxPduCfg_<name> になる）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "flowControlSection",
    "blockSize",
    "stMin",
    "timeoutSection",
    "nCrTimeoutMs",
    "nBsTimeoutMs",
    "nAsTimeoutMs",
    "idSection",
    "canIfTxPdu",
    "txNPduId",
    "rxNPduId",
    "txSduId",
    "rxSduId",
    "dcmTxPduId",
    "dcmRxPduId"
  ],
  "$defs": {
    "doc": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "not": {
          "pattern": "\\*/"
        }
      },
      "description": "定義の直前に出す Doxygen コメントの行"
    },
    "section": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "not": {
          "pattern": "\\*/"
        }
      },
      "description": "見出しコメントの行"
    },
    "byte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "doc": {
          "$ref": "#/$defs/doc"
        }
      }
    },
    "ms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "時間 [ms]"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "module": {
      "const": "CanTp"
    },
    "flowControlSection": {
      "$ref": "#/$defs/section"
    },
    "blockSize": {
      "$ref": "#/$defs/byte",
      "description": "ブロックサイズ (BS)"
    },
    "stMin": {
      "$ref": "#/$defs/byte",
      "description": "最小分離時間 (STmin)"
    },
    "timeoutSection": {
      "$ref": "#/$defs/section"
    },
    "nCrTimeoutMs": {
      "$ref": "#/$defs/ms"
    },
    "nBsTimeoutMs": {
      "$ref": "#/$defs/ms"
    },
    "nAsTimeoutMs": {
      "$ref": "#/$defs/ms"
    },
    "idSection": {
      "$ref": "#/$defs/section"
    },
    "canIfTxPdu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdu",
        "doc"
      ],
      "properties": {
        "pdu": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "CanIf.json の txPdus の name（txConfirm が CANTP のもの）"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        }
      }
    },
    "txNPduId": {
      "$ref": "#/$defs/byte",
      "description": "CanIf が CanTp_TxConfirmation() に渡す TX N-PDU の ID"
    },
    "rxNPduId": {
      "$ref": "#/$defs/byte",
      "description": "CanIf が CanTp_RxIndication() に渡す RX N-PDU の ID"
    },
    "txSduId": {
      "$ref": "#/$defs/byte",
      "description": "PduR が CanTp_Transmit() に渡す TX N-SDU ID"
    },
    "rxSduId": {
      "$ref": "#/$defs/byte",
      "description": "PduR_CanTpStartOfReception() などが受け取る RX N-SDU ID"
    },
    "dcmRxPduId": {
      "$ref": "#/$defs/byte",
      "description": "Dcm の RX I-PDU の ID（Dcm_StartOfReception() などに渡す）"
    },
    "dcmTxPduId": {
      "$ref": "#/$defs/byte",
      "description": "Dcm の TX I-PDU の ID（Dcm_CopyTxData() などに渡す）"
    }
  }
}
