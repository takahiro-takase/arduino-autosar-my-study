{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FiM configuration",
  "description": "FiM_Cfg.h の機能 ID と、FiM_PBCfg.c の FID × Dem イベント対応テーブルの生成元。機能の並び順がそのまま FID。機能ごとに、抑止の条件（Dem イベントと、抑止するステータスのビット）を 1 つ以上書き、Dem のイベント・ステータスのマクロは、Dem_Cfg.h に実在する名前で書く。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "functions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "module": {
      "const": "FiM"
    },
    "summaryEvents": {
      "type": "array",
      "description": "複数の Dem イベントをまとめた名前（FiMSummaryEvent に相当）。functions[].inhibitions[].summary から参照する",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "events"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "Dem.json の events[].name"
            }
          }
        }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "inhibitions",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "機能名（FIM_FID_<name> のマクロ名になる）"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "機能の説明（FID マクロのコメントとテーブルの見出し）"
          },
          "inhibitions": {
            "type": "array",
            "minItems": 1,
            "description": "この機能を抑止する条件（Dem イベントと、抑止するステータスのビット）。複数あれば、どれか 1 つでも成り立てば、機能を抑止する（OR、[SWS_Fim_00064]）",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "summary": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$",
                  "description": "summaryEvents[].name（FiMInhSumRef に相当）。まとめたイベントごとに、同じ条件の行へ展開する"
                },
                "type": {
                  "enum": [
                    "FIM_LAST_FAILED",
                    "FIM_NOT_TESTED",
                    "FIM_TESTED",
                    "FIM_TESTED_AND_FAILED"
                  ],
                  "description": "仕様の抑止の条件（FiMInhInhibitionMask）。LAST_FAILED=TestFailed（bit0）、NOT_TESTED=TestNotCompletedThisOperationCycle（bit6）、TESTED=bit6 が無い、TESTED_AND_FAILED=bit0 があり bit6 が無い"
                },
                "event": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$",
                  "description": "監視する Dem イベントの名前（Dem.json の events[].name。生成物では DemConf_DemEventParameter_<name>）"
                },
                "statusMask": {
                  "type": "string",
                  "pattern": "^DEM_STATUS_[A-Z0-9_]+$",
                  "description": "抑止するステータスのビット（Dem_Cfg.h の DEM_STATUS_*）。いずれか 1 ビットでも立っていれば抑止する"
                }
              },
              "description": "event か summary のどちらか 1 つ（対象）と、statusMask か type のどちらか 1 つ（条件）を書く",
              "allOf": [
                {
                  "oneOf": [
                    {
                      "required": [
                        "event"
                      ]
                    },
                    {
                      "required": [
                        "summary"
                      ]
                    }
                  ]
                },
                {
                  "oneOf": [
                    {
                      "required": [
                        "statusMask"
                      ]
                    },
                    {
                      "required": [
                        "type"
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "note": {
            "type": "array",
            "description": "テーブルの、この機能の見出しコメント",
            "items": {
              "type": "string",
              "not": {
                "pattern": "\\*/"
              }
            }
          }
        }
      }
    }
  }
}
