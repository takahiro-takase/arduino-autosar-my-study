{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Can configuration",
  "description": "Can_Cfg.h のピン番号と、Can_PBCfg.c の Can_Config（フィルタ・ピン・ボーレート・水晶）の生成元。ボーレートと水晶の指定は、Can_Cfg.h の CAN_BAUDRATE_* / CAN_CRYSTAL_*MHZ に実在する名前で書く。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "csPin",
    "csPinDoc",
    "intPin",
    "intPinDoc",
    "baudrate",
    "crystalMhz",
    "filter",
    "filterNote",
    "controller",
    "fd"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "module": {
      "const": "Can"
    },
    "controller": {
      "enum": [
        "MCP2515",
        "MCP2518FD"
      ],
      "description": "CAN コントローラの種類。MCP2515 は CAN 2.0 まで、MCP2518FD は CAN FD に対応する。水晶の周波数と FD の指定は、この種類に合っている必要がある"
    },
    "csPin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "SPI チップセレクト (CS) のピン番号（CAN_CS_PIN）"
    },
    "csPinDoc": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "\\*/"
      },
      "description": "CAN_CS_PIN のコメント"
    },
    "intPin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "割り込み (INT) のピン番号（CAN_INT_PIN）"
    },
    "intPinDoc": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "\\*/"
      },
      "description": "CAN_INT_PIN のコメント"
    },
    "baudrate": {
      "type": "string",
      "pattern": "^[0-9K]+BPS$",
      "description": "ボーレート。CAN_BAUDRATE_<値> の <値>（例: 500KBPS）"
    },
    "crystalMhz": {
      "enum": [
        8,
        16,
        20,
        40
      ],
      "description": "水晶発振器の周波数 [MHz]（CAN_CRYSTAL_<値>MHZ）。MCP2515: 8 / 16 / 20、MCP2518FD: 20 / 40"
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mask"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{1,8}$",
          "description": "受け付ける CAN ID（16 進）"
        },
        "mask": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{1,8}$",
          "description": "フィルタマスク（16 進。1 のビットは一致必須）"
        }
      }
    },
    "filterNote": {
      "type": "array",
      "minItems": 1,
      "description": "フィルタ設定のコメント",
      "items": {
        "type": "string",
        "not": {
          "pattern": "\\*/"
        }
      }
    },
    "fd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "dataBitrate",
        "txBitRateSwitch",
        "note"
      ],
      "description": "CAN FD の設定（AUTOSAR の CanControllerFdBaudrateConfig / CanControllerTxBitRateSwitch 相当）",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "CAN FD を有効にする（controller が FD 対応のときだけ true にできる）"
        },
        "dataBitrate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000000,
          "description": "データ部のビットレート [bit/s]。通常のビットレートの整数倍。使うトランシーバの上限を超えない値にする"
        },
        "txBitRateSwitch": {
          "type": "boolean",
          "description": "送信時にデータ部でビットレートを切り替える（BRS）"
        },
        "note": {
          "type": "array",
          "minItems": 1,
          "description": "FD 設定のコメント",
          "items": {
            "type": "string",
            "not": {
              "pattern": "\\*/"
            }
          }
        }
      }
    }
  }
}
