{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComM configuration",
  "description": "ComM_Cfg.h のチャネル数・ユーザ数・ID の定義の生成元。チャネル数は CanSM.json と一致すること（生成時に検査する）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "channelCount",
    "userCount",
    "channel0",
    "user0"
  ],
  "$defs": {
    "doc": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "not": {
          "pattern": "\\*/"
        }
      },
      "description": "定義の直前に出す Doxygen コメントの行"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "module": {
      "const": "ComM"
    },
    "channelCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "管理チャネル数"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        }
      }
    },
    "userCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "管理ユーザ数"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        }
      }
    },
    "channel0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 254,
          "description": "チャネル 0 の ID（チャネル数未満）"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        }
      }
    },
    "user0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 254,
          "description": "ユーザ 0 の ID（ユーザ数未満）"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        }
      }
    }
  }
}
