{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanNm configuration",
  "description": "CanNm_Cfg.h の NM フレーム・タイマの定義の生成元。NM フレームの CanIf の PDU は、CanIf.json の PDU の名前で指す（生成物ではシンボリック名 CanIfConf_*_<name> になる）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "frameSection",
    "cycleMs",
    "dlc",
    "sourceNodeId",
    "canifTxPdu",
    "canifRxPdu",
    "nmTxPduId",
    "nmRxPduId",
    "timerSection",
    "timeoutMs",
    "repeatMessageMs",
    "waitBusSleepMs"
  ],
  "$defs": {
    "doc": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "not": {
          "pattern": "\\*/"
        }
      },
      "description": "定義の直前に出す Doxygen コメントの行"
    },
    "section": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "not": {
          "pattern": "\\*/"
        }
      },
      "description": "見出しコメントの行"
    },
    "pduId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "doc": {
          "$ref": "#/$defs/doc"
        },
        "unused": {
          "type": "boolean"
        }
      }
    },
    "ms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "時間 [ms]"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        },
        "unused": {
          "type": "boolean",
          "description": "true なら MISRA 2.5（未使用マクロ）の抑止コメントを付ける"
        }
      }
    },
    "pdu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdu",
        "doc"
      ],
      "properties": {
        "pdu": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "CanIf.json の PDU の name"
        },
        "unused": {
          "type": "boolean",
          "description": "true なら MISRA 2.5（未使用マクロ）の抑止コメントを付ける"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "module": {
      "const": "CanNm"
    },
    "frameSection": {
      "$ref": "#/$defs/section"
    },
    "cycleMs": {
      "$ref": "#/$defs/ms",
      "description": "CanNm_MainFunction() の呼び出し周期。Os_PBCfg.c のタスク周期と一致すること（生成時に検査する）"
    },
    "dlc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8,
          "description": "NM PDU のバイト長（Control Bit Vector と Source Node Identifier で 2 バイト以上）"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        }
      }
    },
    "sourceNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{2}$",
          "description": "NM ノード識別子"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        }
      }
    },
    "canifTxPdu": {
      "$ref": "#/$defs/pdu",
      "description": "NM フレームの CanIf の TX PDU（txConfirm が CANNM のもの）"
    },
    "canifRxPdu": {
      "$ref": "#/$defs/pdu",
      "description": "NM フレームの CanIf の RX PDU（rxIndication が CANNM のもの）"
    },
    "nmTxPduId": {
      "$ref": "#/$defs/pduId",
      "description": "CanNm 側の TX PDU の ID（CanIf が TxConfirmation で CanNm へ返す ID）"
    },
    "nmRxPduId": {
      "$ref": "#/$defs/pduId",
      "description": "CanNm 側の RX PDU の ID（CanIf が RxIndication で CanNm へ渡す ID）"
    },
    "timerSection": {
      "$ref": "#/$defs/section"
    },
    "timeoutMs": {
      "$ref": "#/$defs/ms"
    },
    "repeatMessageMs": {
      "$ref": "#/$defs/ms"
    },
    "waitBusSleepMs": {
      "$ref": "#/$defs/ms"
    }
  }
}
