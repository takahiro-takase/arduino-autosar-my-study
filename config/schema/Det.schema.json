{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Det configuration",
  "description": "Det_Cfg.h のログレベルの既定値（DET_LOG_LEVEL）の生成元。ビルド設定の -DDET_LOG_LEVEL=... で上書きできる。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "logLevel"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "module": {
      "const": "Det"
    },
    "logLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "doc"
      ],
      "properties": {
        "value": {
          "enum": [
            "LOG_T",
            "LOG_E",
            "LOG_W",
            "LOG_I",
            "LOG_D"
          ],
          "description": "既定のログレベル（Det.h の LogLevel）。LOG_T=TRACE、LOG_E=ERROR、LOG_W=WARN、LOG_I=INFO、LOG_D=DEBUG"
        },
        "doc": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*\\*/).*$",
          "description": "既定値の説明（行末のコメントとして出す）"
        }
      }
    }
  }
}
