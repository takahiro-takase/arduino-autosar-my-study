{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wdg configuration",
  "description": "Wdg_PBCfg.c の Wdg_Config（HW ウォッチドッグのタイムアウト）の生成元。タイムアウトは WdgM_Cfg.h に実在するマクロ名で指定する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "defaultTimeout"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "module": {
      "const": "Wdg"
    },
    "defaultTimeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro"
      ],
      "properties": {
        "macro": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "HW ウォッチドッグのタイムアウト [ms] を表すマクロ名（WdgM_Cfg.h に実在し、値が 1〜65535）"
        },
        "doc": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "not": {
              "pattern": "\\*/"
            }
          },
          "description": "説明（Wdg_Config の直前のコメントとして出す）"
        }
      }
    }
  }
}
