{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanIf configuration",
  "description": "CanIf_PBCfg.c / CanIf_Cfg.h の生成元。CAN ID と DLC は、frame が指すフレーム（config/data/can_signals.json）から引く。信号表に無いフレーム（UDS 診断など）だけ canId と dlc を直接書く。",
  "type": "object",
  "additionalProperties": false,
  "required": ["module", "txPduCountDoc", "rxPduCountDoc", "txPdus", "rxPdus"],
  "properties": {
    "$schema": { "type": "string" },
    "module": { "const": "CanIf" },
    "txPduCountDoc": { "$ref": "#/$defs/commentLines" },
    "rxPduCountDoc": { "$ref": "#/$defs/commentLines" },
    "txPdus": { "type": "array", "minItems": 1, "maxItems": 255, "items": { "$ref": "#/$defs/txPdu" } },
    "rxPdus": { "type": "array", "minItems": 1, "maxItems": 255, "items": { "$ref": "#/$defs/rxPdu" } }
  },
  "$defs": {
    "commentLines": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "not": { "pattern": "\\*/" } }
    },
    "pduId": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "shortName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
    "canId": { "type": "string", "pattern": "^0x[0-9A-F]{1,8}$", "description": "16 進（大文字）" },
    "text": { "type": "string", "minLength": 1, "not": { "pattern": "\\*/" } },
    "txPdu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "hth", "txConfirm"],
      "properties": {
        "name": { "$ref": "#/$defs/shortName", "description": "CanIfTxPduCfg の ShortName" },
        "frame": { "$ref": "#/$defs/text", "description": "信号表（can_signals.json）のフレーム名。CAN ID と DLC をここから引く" },
        "canId": { "$ref": "#/$defs/canId" },
        "dlc": { "type": "integer", "minimum": 0, "maximum": 8 },
        "title": { "$ref": "#/$defs/text" },
        "note": { "$ref": "#/$defs/commentLines" },
        "upperLayerTxPduId": { "$ref": "#/$defs/pduId", "description": "TxConfirmation で上位層へ返す PDU ID。txConfirm が PDUR のときだけ書く（CANNM のときは CanNm.json の nmTxPduId から引く）" },
        "hth": { "type": "integer", "minimum": 0, "maximum": 255 },
        "txConfirm": { "enum": ["PDUR", "CANNM", "CANTSYN"], "description": "送信完了通知の宛先（CANTSYN は時刻同期 CanTSyn。上位層へ返す ID は CanTSyn_Cfg.h の CANTSYN_TX_PDU_ID）" },
        "notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "upperLayerTxPduId": { "$ref": "#/$defs/commentLines" },
            "dlc": { "$ref": "#/$defs/commentLines" },
            "txConfirm": { "$ref": "#/$defs/commentLines" }
          }
        }
      }
    },
    "rxPdu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "hrh", "rxIndication"],
      "properties": {
        "name": { "$ref": "#/$defs/shortName", "description": "CanIfRxPduCfg の ShortName" },
        "frame": { "$ref": "#/$defs/text" },
        "canId": { "$ref": "#/$defs/canId" },
        "dlc": { "type": "integer", "minimum": 0, "maximum": 8 },
        "title": { "$ref": "#/$defs/text" },
        "note": { "$ref": "#/$defs/commentLines" },
        "upperLayerRxPduId": { "$ref": "#/$defs/pduId", "description": "上位層へ渡す受信 PDU ID。rxIndication が PDUR のときだけ書く（CANNM のときは CanNm.json の nmRxPduId から引く）" },
        "hrh": { "type": "integer", "minimum": 0, "maximum": 255 },
        "rxIndication": { "enum": ["PDUR", "CANNM", "CANTSYN"], "description": "受信通知の宛先（CANTSYN は時刻同期 CanTSyn。上位層へ渡す ID は CanTSyn_Cfg.h の CANTSYN_RX_PDU_ID）" },
        "notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "upperLayerRxPduId": { "$ref": "#/$defs/commentLines" },
            "dlc": { "$ref": "#/$defs/commentLines" }
          }
        }
      }
    }
  }
}
